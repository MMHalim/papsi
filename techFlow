        // --- Component: Analytics Dashboard ---
        const AnalyticsDashboard = ({ data }) => {
            const stats = useMemo(() => {
                const counts = {};
                if (FLOW_DATA.start.options) {
                    FLOW_DATA.start.options.forEach(opt => counts[opt.label] = 0);
                }
                data.forEach(entry => { if (counts[entry.sop_label] !== undefined) counts[entry.sop_label]++; });
                return Object.entries(counts).sort((a, b) => b[1] - a[1]);
            }, [data]);
            const maxCount = Math.max(...stats.map(s => s[1]), 1);
            return (
                <div className="space-y-6">
                    <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div className="bg-blue-50 p-4 rounded-lg border border-blue-100 shadow-sm"><p className="text-blue-600 text-[10px] font-black uppercase tracking-widest leading-none">Total Logs</p><p className="text-3xl font-black text-blue-900 mt-1">{data.length}</p></div>
                        <div className="bg-green-50 p-4 rounded-lg border border-green-100 shadow-sm col-span-2"><p className="text-green-600 text-[10px] font-black uppercase tracking-widest leading-none">Primary Concerns</p><p className="text-xl font-black text-green-900 truncate mt-1">{stats[0]?.[0] || 'N/A'}</p></div>
                    </div>
                    <div className="bg-white border border-slate-200 rounded-xl p-6 shadow-sm">
                        <h3 className="font-bold text-slate-800 mb-6 flex items-center gap-2 text-sm uppercase tracking-wider"><Icon name="bar-chart-3" /> SOP Usage Breakdown</h3>
                        <div className="space-y-5">
                            {stats.map(([label, count]) => (
                                <div key={label} className="space-y-1.5">
                                    <div className="flex justify-between text-[10px] font-black text-slate-400 uppercase tracking-widest"><span>{label}</span><span>{count}</span></div>
                                    <div className="w-full bg-slate-100 h-2 rounded-full overflow-hidden">
                                        <div className="bg-blue-600 h-full rounded-full transition-all duration-1000" style={{ width: `${(count / maxCount) * 100}%` }} />
                                    </div>
                                </div>
                            ))}
                        </div>
                    </div>
                </div>
            );
        };

        // --- Main Component: App ---
        function App() {
            const [history, setHistory] = useState(['start']);
            const [view, setView] = useState('tool');
            const [analyticsData, setAnalyticsData] = useState([]);
            const currentStepId = history[history.length - 1];
            const step = FLOW_DATA[currentStepId] || FLOW_DATA.start;

            useEffect(() => {
                if (!db) return;
                auth.signInAnonymously().catch(e => console.error("Auth:", e));
                const unsubscribe = db.collection('sop_usage').onSnapshot(snap => {
                    setAnalyticsData(snap.docs.map(doc => doc.data()));
                }, err => console.error("Firestore:", err));
                return () => unsubscribe();
            }, []);

            const handleNext = async (nextId, label) => {
                if (currentStepId === 'start' && db) {
                    db.collection('sop_usage').add({
                        sop_label: label,
                        timestamp: firebase.firestore.FieldValue.serverTimestamp()
                    });
                }
                setHistory(prev => [...prev, nextId]);
            };

            const handleBack = () => history.length > 1 && setHistory(prev => prev.slice(0, -1));

            return (
                <div className="min-h-screen p-4 md:p-8 flex flex-col items-center">
                    <div className="w-full max-w-2xl bg-white rounded-3xl shadow-2xl overflow-hidden flex flex-col min-h-[680px] border border-slate-200">
                        <header className="bg-slate-900 text-white p-6 flex flex-col md:flex-row justify-between items-center gap-4">
                            <div className="flex items-center gap-3">
                                <div className="bg-blue-600 p-2 rounded-xl shadow-lg"><Icon name="monitor" size={24} /></div>
                                <div><h1 className="text-xl font-black leading-none tracking-tight">TEMPO SUPPORT</h1><p className="text-slate-400 text-[10px] font-bold uppercase tracking-widest mt-1">Interactive Tier 1 Hub</p></div>
                            </div>
                            <div className="flex bg-slate-800 p-1 rounded-2xl shadow-inner border border-slate-700">
                                <button onClick={() => setView('tool')} className={`px-5 py-1.5 rounded-xl text-xs font-black transition-all ${view === 'tool' ? 'bg-white text-slate-900 shadow-sm' : 'text-slate-500 hover:text-white'}`}>TOOL</button>
                                <button onClick={() => setView('analytics')} className={`px-5 py-1.5 rounded-xl text-xs font-black transition-all ${view === 'analytics' ? 'bg-white text-slate-900 shadow-sm' : 'text-slate-500 hover:text-white'}`}>DATA</button>
                            </div>
                        </header>

                        {view === 'tool' ? (
                            <>
                                <nav className="bg-slate-50 border-b border-slate-200 px-6 py-3 flex items-center justify-between">
                                    <div className="flex items-center gap-3">
                                        {history.length > 1 && <button onClick={handleBack} className="text-slate-500 hover:text-slate-900 text-[10px] font-black uppercase flex items-center gap-1.5 transition-all active:scale-95"><Icon name="arrow-left" size={14}/> Back</button>}
                                        <div className="h-4 w-px bg-slate-300 mx-1"></div>
                                        <span className="text-blue-600 text-[10px] font-black uppercase tracking-wider leading-none">Step {history.length}</span>
                                    </div>
                                    <button onClick={() => setHistory(['start'])} className="text-slate-400 hover:text-red-500 text-[10px] font-black uppercase tracking-widest flex items-center gap-1.5 leading-none transition-colors"><Icon name="rotate-ccw" size={14}/> Reset Flow</button>
                                </nav>
                                <main className="flex-grow p-6 md:p-8 overflow-y-auto no-scrollbar">
                                    <div className="animate-fade-in">
                                        <div className="flex items-center gap-3 mb-4">
                                            <div className="w-2 h-2 rounded-full bg-blue-600 shadow-sm shadow-blue-200"></div>
                                            <h2 className="text-xl font-black text-slate-800 uppercase tracking-tight">{step.title}</h2>
                                        </div>
                                        <div className="text-slate-700 mb-10 leading-relaxed font-semibold text-base whitespace-pre-wrap">{step.content}</div>
                                        
                                        {step.action && (
                                            <div className="p-4 bg-amber-50 border-l-4 border-amber-400 rounded-r-2xl mb-10 flex items-start gap-4 shadow-sm">
                                                <Icon name="alert-triangle" size={20} className="text-amber-500 flex-shrink-0 mt-0.5" />
                                                <div>
                                                    <p className="text-[10px] font-black text-amber-700 uppercase tracking-widest opacity-70 mb-1">Mandatory Interaction Step</p>
                                                    <p className="text-sm font-black text-amber-950 leading-tight uppercase">{step.action.text}</p>
                                                </div>
                                            </div>
                                        )}

                                        <div className="space-y-3">
                                            {step.options && step.options.map((option, index) => (
                                                <button key={index} onClick={() => handleNext(option.next, option.label)} className="w-full text-left p-5 rounded-2xl border border-slate-200 hover:border-blue-500 hover:bg-blue-50 transition-all flex justify-between items-center group bg-white shadow-sm active:scale-[0.98] duration-75">
                                                    <div className="flex items-center gap-5">
                                                        <div className="p-2.5 rounded-xl bg-slate-50 group-hover:bg-blue-100 transition-colors shadow-inner border border-slate-100">
                                                            <Icon name={option.icon || 'check'} size={18} className="text-slate-400 group-hover:text-blue-600" />
                                                        </div>
                                                        <span className="font-black text-slate-700 group-hover:text-blue-900 text-sm uppercase tracking-tighter leading-none">{option.label}</span>
                                                    </div>
                                                    <Icon name="chevron-right" size={20} className="text-slate-300 group-hover:text-blue-500 group-hover:translate-x-1 transition-all" />
                                                </button>
                                            ))}
                                        </div>
                                    </div>
                                    <div className="mt-12 pt-8 border-t border-gray-200">
                                        <div className="flex justify-between items-center mb-4"><h3 className="font-black text-slate-700 text-[10px] uppercase tracking-widest flex items-center gap-1.5 leading-none"><Icon name="file-text" size={14}/> Support Ticket Template</h3><CopyButton text={NOTE_TEMPLATE} /></div>
                                        <pre className="text-[11px] text-slate-500 whitespace-pre-wrap bg-slate-50 p-5 rounded-2xl border border-slate-200 font-mono leading-relaxed shadow-inner">{NOTE_TEMPLATE}</pre>
                                    </div>
                                </main>
                            </>
                        ) : (
                            <div className="p-8 flex-grow bg-slate-50/50 overflow-y-auto no-scrollbar">
                                <div className="flex items-center justify-between mb-10 border-b border-slate-200 pb-6">
                                    <h2 className="text-2xl font-black text-slate-900 tracking-tighter uppercase leading-none">Global Team Stats</h2>
                                    <span className="px-3 py-1 bg-green-100 text-green-700 rounded-full text-[10px] font-black uppercase tracking-widest flex items-center gap-1.5 border border-green-200 shadow-sm animate-pulse">
                                        <div className="w-1.5 h-1.5 rounded-full bg-green-500"></div> Sync Active
                                    </span>
                                </div>
                                <AnalyticsDashboard data={analyticsData} />
                            </div>
                        )}
                    </div>
                </div>
            );
        }

        const container = document.getElementById('root');
        const root = ReactDOM.createRoot(container);
        root.render(<App />);
    </script>
</body>
</html>
